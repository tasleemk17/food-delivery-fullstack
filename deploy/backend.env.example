# Copy this file to backend/.env on the SERVER and fill in the values. Never commit the real file.
#
#   cp deploy/backend.env.example backend/.env
#
# Generate the two random secrets with:  openssl rand -hex 32

# MongoDB Atlas connection string. In Atlas, allow the server's IP address (Network Access).
MONGODB_URI=

# The gateway and the backend must have the same JWT_SECRET (the gateway checks what the backend signs).
JWT_SECRET=

# Shared between the Java services and the backend for the service-to-service calls.
INTERNAL_API_KEY=

# Stripe TEST keys (sk_test_...). The webhook secret comes from the endpoint you add in the Stripe dashboard:
#   http://<server>:8090/api/order/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=4000
# FRONTEND_URL and ADMIN_URL are set automatically from PUBLIC_HOST by deploy/docker-compose.prod.yml.
