# Optional. Copy to .env in the project folder on the SERVER (next to docker-compose.yml). Never commit it.
#
#   cp deploy/root.env.example .env

# The address people type in the browser. Leave it out on EC2 and it is looked up from the instance.
# Set it when you use an Elastic IP or a domain name.
# PUBLIC_HOST=203.0.113.10

# Turns on the chatbot's AI answers (without it the chatbot answers from search only).
# A smaller model is much cheaper and fast enough for short menu answers.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Database passwords. The defaults are for a laptop: change all four on a server.
# ORDERS_DB_PASSWORD=
# INVENTORY_DB_PASSWORD=
# NOTIFICATIONS_DB_PASSWORD=
# AI_DB_PASSWORD=
